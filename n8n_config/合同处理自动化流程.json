                  {
                    "id": "c14d2786-2377-4d16-a4e8-a90ae0eacdeb",
                    "leftValue": "={{ $json.json.body.data.overall_risk_level }}",
                    "rightValue": "high",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
